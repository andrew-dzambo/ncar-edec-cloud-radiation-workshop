{
  "name": "Cloud radiation workshop",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "remoteUser": "vscode",
  "waitFor": "updateContentCommand",
  "postCreateCommand": "bash .devcontainer/prepare-workshop.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["RRTMGP_Cloud_Workshop.ipynb"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/envs/rrtmgp/bin/python"
      }
    }
  }
}
